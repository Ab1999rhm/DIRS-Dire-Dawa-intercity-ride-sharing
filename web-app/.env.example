# ================================================
# DIRS Web App — Environment Variables
# ================================================
# For Vercel: set these in Dashboard → Project → Settings → Environment Variables
# For local dev: copy to .env.local

# Your Render backend URL (NO trailing slash)
REACT_APP_API_URL=https://dirs-backend.onrender.com/api

# App name (cosmetic, used in titles/meta)
REACT_APP_NAME=DIRS Ride Sharing
