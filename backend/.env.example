# ================================================
# DIRS Backend — Environment Variables
# ================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Server ---
NODE_ENV=production
PORT=10000

# --- MongoDB Atlas ---
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dirs?retryWrites=true&w=majority

# --- JWT Secrets (use long random strings, min 64 chars) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_64CHARS
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRE=30d

# --- Frontend URLs (Comma-separated allowed origins) ---
# Set these AFTER deploying the frontend on Vercel
FRONTEND_URL=https://dirs-web-app.vercel.app
PASSENGER_APP_URL=https://dirs-web-app.vercel.app
DRIVER_APP_URL=https://dirs-web-app.vercel.app
ADMIN_APP_URL=https://dirs-web-app.vercel.app

# --- Backend public URL (your Render service URL) ---
BACKEND_URL=https://dirs-backend.onrender.com

# --- Email / SMTP (REQUIRED for OTP emails to be delivered) ---
# Brevo (recommended, free 300 emails/day): https://www.brevo.com
#   1. Login -> SMTP & API -> SMTP Relay
#   2. SMTP_USER = your Brevo login email
#   3. SMTP_PASS = the generated SMTP key
#   4. Verify your sender email under Senders before sending
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_email@example.com
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM='"DIRS Ride Sharing" <noreply@example.com>'
# Preferred if SMTP is unreachable from your host (Render): HTTP API over 443.
# Generate: Brevo -> SMTP & API -> API Keys -> Generate (Transactional Emails) -> key starts with xkeysib-
# When BREVO_API_KEY is set, OTP emails go through the HTTP API instead of SMTP.
BREVO_API_KEY=your_brevo_api_key

# --- Keep-alive cron (prevents Render free plans from sleeping) ---
# The backend pings these URLs every KEEP_ALIVE_INTERVAL_MINUTES minutes.
# For reliable wake-from-sleep, also set up a free external pinger (e.g. cron-job.org)
# that hits https://<your-backend>.onrender.com/api/health every 5 minutes.
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=10
KEEP_ALIVE_URLS=https://dirs-backend.onrender.com/api/health,https://dirs-web-app.vercel.app/

# --- Chapa (payouts + card payments) ---
# Get keys from: https://dashboard.chapa.co/profile/api
# Used for top-ups (charge) AND withdrawals (transfers). For transfers you must
# add your server approval URL (or OTP approval) in Chapa dashboard:
#   Settings -> Account Settings -> Transfer Approval
# Approval URL to set: https://<your-backend>.onrender.com/api/payments/chapa/approval
CHAPA_SECRET_KEY=CHASECK_TEST_your_secret_key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST_your_public_key
CHAPA_ENCRYPTION_KEY=your_chapa_encryption_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
# Used to sign the server-approval webhook payloads from Chapa (HMAC SHA256).
CHAPA_APPROVAL_SECRET=your_chapa_approval_secret
