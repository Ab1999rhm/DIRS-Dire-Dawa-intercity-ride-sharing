# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dirs_diredawa?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS - Set to your Vercel deployment URLs
FRONTEND_URL=https://your-app.vercel.app
PASSENGER_APP_URL=https://your-app.vercel.app
DRIVER_APP_URL=https://your-app.vercel.app
ADMIN_APP_URL=https://your-app.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# Email (Ethereal for testing, use real SMTP for production)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_email@ethereal.email
SMTP_PASS=your_password

# Payment Gateways (optional)
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_PUBLIC_KEY=your_chapa_public_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
