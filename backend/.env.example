# ================================================
# DIRS Backend — Environment Variables
# ================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Server ---
NODE_ENV=production
PORT=10000

# --- MongoDB Atlas ---
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dirs?retryWrites=true&w=majority

# --- JWT Secrets (use long random strings, min 64 chars) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_64CHARS
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRE=30d

# --- Frontend URLs (Comma-separated allowed origins) ---
# Set these AFTER deploying the frontend on Vercel
FRONTEND_URL=https://dirs-web-app.vercel.app
PASSENGER_APP_URL=https://dirs-web-app.vercel.app
DRIVER_APP_URL=https://dirs-web-app.vercel.app
ADMIN_APP_URL=https://dirs-web-app.vercel.app

# --- Backend public URL (your Render service URL) ---
BACKEND_URL=https://dirs-backend.onrender.com
